{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Material Gater",
  "version": "0.7.0",
  "identifier": "com.materialgater.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Material Gater",
        "width": 1320,
        "height": 840,
        "minWidth": 1050,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0c0f12"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Video",
    "shortDescription": "轻量跨平台素材拷贝与映射管理器",
    "longDescription": "Material Gater 识别素材盘，建立索引、映射链接并执行可恢复的后台拷贝任务。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
